{
  "name": "llm-toolbox",
  "description": "Reusable Claude Code skills: code-tutor, distrobox, guided-build, icon-search, image, pr-opener, screenshot, svg-generator, tech-blog-post, ui-review.",
  "version": "1.0.49",
  "author": {
    "name": "Breno Zanato Detomini",
    "email": "brenozd@gmail.com"
  },
  "mcpServers": {
    "actual-budget": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-v",
        "${HOME}/.config/llm-toolbox/actual-budget.json:/config/config.json:ro",
        "-v",
        "actual-budget-data:/data",
        "registry.bzd.gg/bzd/actual-budget-mcp:latest"
      ]
    },
    "woodpecker": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-v",
        "${HOME}/.config/llm-toolbox/woodpecker.json:/config/config.json:ro",
        "registry.bzd.gg/bzd/woodpecker-mcp:latest"
      ]
    },
    "faster-whisper": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-v",
        "${HOME}:${HOME}:ro",
        "registry.bzd.gg/bzd/faster-whisper-mcp:latest"
      ]
    }
  }
}
