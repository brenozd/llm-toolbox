{
  "name": "llm-toolbox",
  "description": "Reusable Claude Code skills: bug-sweep, doc-audit, guided-build, image, screenshot, tech-blog-post.",
  "version": "1.0.8",
  "author": {
    "name": "Breno Zanato Detomini",
    "email": "brenozd@gmail.com"
  },
  "mcpServers": {
    "actual-budget": {
      "command": "docker",
      "args": [
        "run", "-i", "--rm",
        "-v", "${HOME}/.config/llm-toolbox/actual-budget.json:/config/config.json:ro",
        "-v", "actual-budget-data:/data",
        "pulp.bzd.gg/bzd/actual-budget-mcp:latest"
      ]
    },
    "woodpecker": {
      "command": "docker",
      "args": [
        "run", "-i", "--rm",
        "-v", "${HOME}/.config/llm-toolbox/woodpecker.json:/config/config.json:ro",
        "pulp.bzd.gg/bzd/woodpecker-mcp:latest"
      ]
    }
  }
}
