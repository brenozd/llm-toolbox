{
  "name": "llm-toolbox",
  "description": "Reusable Claude Code skills: code-tutor, distrobox, guided-build, icon-search, image, music-search, pr-opener, screencapture, svg-generator, storyboard-video, tech-blog-post, ui-review, wiki-writing.",
  "version": "1.0.82",
  "author": {
    "name": "Breno Zanato Detomini",
    "email": "brenozd@gmail.com"
  },
  "mcpServers": {
    "actual-budget": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-v",
        "${HOME}/.config/llm-toolbox/actual-budget.json:/config/config.json:ro",
        "-v",
        "actual-budget-data:/data",
        "harbor.bzd.gg/bzd/actual-budget-mcp:latest"
      ]
    },
    "woodpecker": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-v",
        "${HOME}/.config/llm-toolbox/woodpecker.json:/config/config.json:ro",
        "harbor.bzd.gg/bzd/woodpecker-mcp:latest"
      ]
    },
    "vikunja": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-v",
        "${HOME}/.config/llm-toolbox/vikunja.json:/config/config.json:ro",
        "harbor.bzd.gg/bzd/vikunja-mcp:latest"
      ]
    },
    "faster-whisper": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-v",
        "${HOME}:${HOME}:ro",
        "-v",
        "${HOME}/.cache/huggingface:/root/.cache/huggingface",
        "harbor.bzd.gg/bzd/faster-whisper-mcp:latest"
      ]
    },
    "whatsapp": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-v",
        "${HOME}/.config/llm-toolbox/whatsapp.json:/config/config.json:ro",
        "-v",
        "whatsapp-data:/data",
        "-v",
        "${HOME}/.config/llm-toolbox/whatsapp-media:/media:ro",
        "harbor.bzd.gg/bzd/whatsapp-mcp:latest"
      ]
    },
    "storyboard-video": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "--cap-drop",
        "ALL",
        "--security-opt",
        "no-new-privileges",
        "--read-only",
        "--tmpfs",
        "/tmp:rw,exec",
        "--tmpfs",
        "/root",
        "--pids-limit",
        "256",
        "--add-host=host.docker.internal:host-gateway",
        "-v",
        "${PWD}:/repo:ro",
        "-v",
        "storyboard-video-work:/work",
        "-v",
        "${HOME}/.cache/storyboard-video/music:/music:ro",
        "harbor.bzd.gg/bzd/storyboard-video-mcp:latest"
      ]
    },
    "storyboard-video-exec": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "--network",
        "none",
        "--cap-drop",
        "ALL",
        "--cap-add",
        "SETGID",
        "--security-opt",
        "no-new-privileges",
        "--read-only",
        "--tmpfs",
        "/tmp:rw,exec",
        "--pids-limit",
        "256",
        "--tmpfs",
        "/root",
        "-e",
        "STORYBOARD_ALLOW_EXEC=1",
        "-v",
        "${PWD}:/repo:ro",
        "-v",
        "storyboard-video-work:/work",
        "-v",
        "${HOME}/.cache/storyboard-video/music:/music:ro",
        "harbor.bzd.gg/bzd/storyboard-video-mcp:latest"
      ]
    }
  }
}
