{
  "name": "llm-toolbox",
  "description": "Reusable Claude Code skills: code-tutor, distrobox, guided-build, icon-search, image, music-search, pr-opener, screencapture, svg-generator, storyboard-video, tech-blog-post, ui-review, wiki-writing.",
  "version": "2.2.0",
  "author": {
    "name": "Breno Zanato Detomini",
    "email": "brenozd@gmail.com"
  },
  "mcpServers": {
    "actual-budget": {
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/lazy-mcp.py",
        "--name",
        "actual-budget",
        "--",
        "docker",
        "run",
        "-i",
        "--rm",
        "-v",
        "${HOME}/.config/llm-toolbox/actual-budget.json:/config/config.json:ro",
        "-v",
        "actual-budget-data:/data",
        "harbor.bzd.gg/bzd/actual-budget-mcp:0.6.0"
      ]
    },
    "woodpecker": {
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/lazy-mcp.py",
        "--name",
        "woodpecker",
        "--",
        "docker",
        "run",
        "-i",
        "--rm",
        "-v",
        "${HOME}/.config/llm-toolbox/woodpecker.json:/config/config.json:ro",
        "harbor.bzd.gg/bzd/woodpecker-mcp:0.1.0"
      ]
    },
    "vikunja": {
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/lazy-mcp.py",
        "--name",
        "vikunja",
        "--",
        "docker",
        "run",
        "-i",
        "--rm",
        "-v",
        "${HOME}/.config/llm-toolbox/vikunja.json:/config/config.json:ro",
        "harbor.bzd.gg/bzd/vikunja-mcp:0.1.0"
      ]
    },
    "audio-transcribe": {
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/lazy-mcp.py",
        "--name",
        "audio-transcribe",
        "--",
        "docker",
        "run",
        "-i",
        "--rm",
        "-v",
        "${HOME}:${HOME}:ro",
        "-v",
        "${HOME}/.cache/huggingface:/root/.cache/huggingface",
        "harbor.bzd.gg/bzd/audio-transcribe-mcp:0.3.0"
      ]
    },
    "document-ocr": {
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/lazy-mcp.py",
        "--name",
        "document-ocr",
        "--",
        "docker",
        "run",
        "-i",
        "--rm",
        "--network",
        "none",
        "--group-add",
        "1000",
        "-e",
        "DOCUMENT_OCR_ROOTS=${HOME}/.config/llm-toolbox/whatsapp-downloads",
        "-v",
        "${HOME}/.config/llm-toolbox/whatsapp-downloads:${HOME}/.config/llm-toolbox/whatsapp-downloads:ro",
        "harbor.bzd.gg/bzd/document-ocr-mcp:0.1.0"
      ]
    },
    "whatsapp": {
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/lazy-mcp.py",
        "--name",
        "whatsapp",
        "--",
        "docker",
        "run",
        "-i",
        "--rm",
        "-v",
        "${HOME}/.config/llm-toolbox/whatsapp.json:/config/config.json:ro",
        "-v",
        "whatsapp-data:/data",
        "-v",
        "${HOME}/.config/llm-toolbox/whatsapp-media:/media:ro",
        "-v",
        "${HOME}/.config/llm-toolbox/whatsapp-downloads:${HOME}/.config/llm-toolbox/whatsapp-downloads",
        "--group-add",
        "1000",
        "harbor.bzd.gg/bzd/whatsapp-mcp:0.2.0"
      ],
      "env": {
        "LAZY_MCP_IDLE_SECONDS": "0"
      }
    },
    "storyboard-video": {
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/lazy-mcp.py",
        "--name",
        "storyboard-video",
        "--",
        "docker",
        "run",
        "-i",
        "--rm",
        "--cap-drop",
        "ALL",
        "--security-opt",
        "no-new-privileges",
        "--read-only",
        "--tmpfs",
        "/tmp:rw,exec",
        "--tmpfs",
        "/root",
        "--pids-limit",
        "256",
        "--add-host=host.docker.internal:host-gateway",
        "-v",
        "${PWD}:/repo:ro",
        "-v",
        "storyboard-video-work:/work",
        "-v",
        "${HOME}/.cache/storyboard-video/music:/music:ro",
        "-v",
        "${HOME}/.cache/storyboard-video/sfx:/sfx:ro",
        "harbor.bzd.gg/bzd/storyboard-video-mcp:0.2.0"
      ]
    },
    "storyboard-video-exec": {
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/lazy-mcp.py",
        "--name",
        "storyboard-video-exec",
        "--",
        "docker",
        "run",
        "-i",
        "--rm",
        "--network",
        "none",
        "--cap-drop",
        "ALL",
        "--cap-add",
        "SETGID",
        "--security-opt",
        "no-new-privileges",
        "--read-only",
        "--tmpfs",
        "/tmp:rw,exec",
        "--pids-limit",
        "256",
        "--tmpfs",
        "/root",
        "-e",
        "STORYBOARD_ALLOW_EXEC=1",
        "-v",
        "${PWD}:/repo:ro",
        "-v",
        "storyboard-video-work:/work",
        "-v",
        "${HOME}/.cache/storyboard-video/music:/music:ro",
        "-v",
        "${HOME}/.cache/storyboard-video/sfx:/sfx:ro",
        "harbor.bzd.gg/bzd/storyboard-video-mcp:0.2.0"
      ]
    }
  }
}
