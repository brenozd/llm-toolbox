          "match": {"any": ["/search?q=", "search_vulnerable"]}
        }
      ],
      "falsePositives": [
        {
          "id": "WEB-FP-PARAM",
          "class": "sql-injection",
          "location": "fixtures/web-api/server.py: GET /search-safe?q= (parameterized)",
          "match": {"any": ["/search-safe"]}
        },
        {
          "id": "WEB-FP-ECHO",
          "class": "xss",
          "location": "fixtures/web-api/server.py: GET /echo?msg= (html.escape)",
          "match": {"any": ["/echo"]}
        }
      ]
    },
