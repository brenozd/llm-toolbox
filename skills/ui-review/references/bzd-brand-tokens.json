{
  "name": "BZD Desenvolvimento de Software",
  "version": "2.0",
  "description": "Full design token set for Light and Dark Mode. Use CSS custom properties from brand-colors.css in production.",

  "colors": {
    "brand": {
      "blue":  { "hex": "#2F6BEB", "oklch": "oklch(0.58 0.18 258)", "name": "Azul BZD",  "usage": "Primary brand color — CTAs, links, interactive elements" },
      "navy":  { "hex": "#0F2A4A", "oklch": "oklch(0.30 0.07 255)", "name": "Marinho",    "usage": "Dark backgrounds, secondary actions, nav, footer" },
      "sky":   { "hex": "#E8F0FE", "oklch": "oklch(0.95 0.03 256)", "name": "Céu",        "usage": "Light tint, badges, chips, subtle backgrounds" },
      "teal":  { "oklch": "oklch(0.56 0.16 185)",                    "name": "Teal",       "usage": "Tertiary accent — tags, success states, highlights" }
    },
    "neutral": {
      "ink":   { "hex": "#14181F", "oklch": "oklch(0.16 0.01 260)", "name": "Tinta",  "usage": "Primary text, headings" },
      "slate": { "hex": "#43505F",                                   "name": "Ardósia","usage": "Body copy" },
      "gray":  { "hex": "#6B7480", "oklch": "oklch(0.50 0.02 260)", "name": "Cinza",  "usage": "Secondary text, labels, captions" },
      "paper": { "hex": "#FBFCFD", "oklch": "oklch(0.99 0.005 260)","name": "Papel",  "usage": "Page/canvas background" }
    }
  },

  "lightMode": {
    "bg-base":            { "value": "#FBFCFD", "usage": "Page background" },
    "bg-surface":         { "value": "#FFFFFF",  "usage": "Cards, panels, modals" },
    "bg-surface-2":       { "value": "#F3F6FA",  "usage": "Alternate section bg, sidebar" },
    "bg-invert":          { "value": "#0F2A4A",  "usage": "Inverted dark blocks (navy)" },
    "border":             { "value": "#E4E8ED",  "usage": "Subtle dividers" },
    "border-strong":      { "value": "#C4CDD9",  "usage": "Input borders, visible outlines" },
    "primary":            { "value": "#2F6BEB",  "usage": "CTA buttons, links, focus ring" },
    "primary-hover":      { "value": "#1C5CD6",  "usage": "Hover/active state" },
    "primary-subtle":     { "value": "#E8F0FE",  "usage": "Tinted badge/chip background" },
    "secondary":          { "value": "#0F2A4A",  "usage": "Dark sections, secondary buttons" },
    "secondary-hover":    { "value": "#1A3A60",  "usage": "Hover state" },
    "secondary-subtle":   { "value": "#D4E2F2",  "usage": "Navy tint background" },
    "tertiary":           { "value": "oklch(0.56 0.16 185)", "usage": "Tags, success, highlights" },
    "tertiary-hover":     { "value": "oklch(0.48 0.16 185)", "usage": "Hover state" },
    "tertiary-subtle":    { "value": "oklch(0.95 0.04 185)", "usage": "Subtle teal background" },
    "text":               { "value": "#14181F",  "usage": "Headings, primary body" },
    "text-2":             { "value": "#43505F",  "usage": "Body copy" },
    "text-3":             { "value": "#6B7480",  "usage": "Labels, captions, metadata" },
    "text-disabled":      { "value": "#9AA3AE",  "usage": "Disabled state" }
  },

  "darkMode": {
    "bg-base":            { "value": "#07101E",  "usage": "Page background" },
    "bg-surface":         { "value": "#0C1929",  "usage": "Cards, panels, modals" },
    "bg-surface-2":       { "value": "#112038",  "usage": "Alternate section bg" },
    "bg-invert":          { "value": "#FBFCFD",  "usage": "Inverted light blocks" },
    "border":             { "value": "#1C3456",  "usage": "Subtle dividers" },
    "border-strong":      { "value": "#2B4D7A",  "usage": "Input borders, visible outlines" },
    "primary":            { "value": "#4D87F6",  "usage": "CTA buttons, links, focus ring" },
    "primary-hover":      { "value": "#6699F8",  "usage": "Hover/active state" },
    "primary-subtle":     { "value": "#0F2240",  "usage": "Subtle primary tint bg" },
    "secondary":          { "value": "#E8F0FE",  "usage": "Secondary button on dark (Céu)" },
    "secondary-hover":    { "value": "#FFFFFF",  "usage": "Hover state" },
    "secondary-subtle":   { "value": "#1A3356",  "usage": "Subtle navy tint on dark" },
    "tertiary":           { "value": "oklch(0.65 0.16 185)", "usage": "Tags, success, highlights" },
    "tertiary-hover":     { "value": "oklch(0.72 0.16 185)", "usage": "Hover state" },
    "tertiary-subtle":    { "value": "oklch(0.20 0.06 185)", "usage": "Subtle dark teal bg" },
    "text":               { "value": "#EBF0FF",  "usage": "Headings, primary body" },
    "text-2":             { "value": "#8BA6CC",  "usage": "Body copy" },
    "text-3":             { "value": "#5A7A9E",  "usage": "Labels, captions, metadata" },
    "text-disabled":      { "value": "#3A5A80",  "usage": "Disabled state" }
  },

  "typography": {
    "sans": {
      "family": "Sora",
      "fallback": "'SF Pro Display', 'Helvetica Neue', sans-serif",
      "weights": [400, 500, 600, 700],
      "usage": "Headings, wordmark, body copy",
      "googleFonts": "https://fonts.google.com/specimen/Sora"
    },
    "mono": {
      "family": "JetBrains Mono",
      "fallback": "'SF Mono', 'Fira Code', monospace",
      "weights": [400, 500],
      "usage": "Labels, code blocks, data, URLs",
      "googleFonts": "https://fonts.google.com/specimen/JetBrains+Mono"
    }
  },

  "radii": {
    "sm":   8,
    "md":   12,
    "lg":   18,
    "tile": 22,
    "icon-64":  16,
    "icon-128": 32,
    "icon-512": 113
  },

  "logo": {
    "cursor": {
      "description": "Small rounded square appended to 'bzd' wordmark — the brand's cursor symbol",
      "lightOnDark": "white",
      "darkOnLight": "#2F6BEB",
      "darkMode":    "#4D87F6",
      "borderRadius": "~15% of cursor size"
    },
    "tile": {
      "primaryFill": "#2F6BEB",
      "darkFill":    "#07101E",
      "inverseFill": "#FFFFFF"
    },
    "minSize": {
      "tile":     "24px — below this, use compact 'b' variant",
      "wordmark": "108px wide",
      "lockupH":  "280px wide"
    },
    "clearSpace": "0.5× tile height on all sides"
  },

  "assets": {
    "icons": [
      { "file": "bzd-icon-blue.svg",  "size": "512×512", "usage": "App icon, primary" },
      { "file": "bzd-icon-dark.svg",  "size": "512×512", "usage": "App icon, dark mode" },
      { "file": "bzd-icon-white.svg", "size": "512×512", "usage": "App icon, white/inverse" }
    ],
    "lockups": [
      { "file": "bzd-lockup-light.svg",          "size": "400×96",  "usage": "Horizontal standard — light bg" },
      { "file": "bzd-lockup-dark.svg",           "size": "400×96",  "usage": "Horizontal standard — dark bg" },
      { "file": "bzd-lockup-compact-light.svg",  "size": "260×52",  "usage": "Compact inline — light bg" },
      { "file": "bzd-lockup-compact-dark.svg",   "size": "260×52",  "usage": "Compact inline — dark bg" },
      { "file": "bzd-lockup-vertical-light.svg", "size": "200×218", "usage": "Vertical stacked — light bg" },
      { "file": "bzd-lockup-vertical-dark.svg",  "size": "200×218", "usage": "Vertical stacked — dark bg" },
      { "file": "bzd-wordmark-light.svg",        "size": "112×48",  "usage": "Wordmark only — light bg" },
      { "file": "bzd-wordmark-dark.svg",         "size": "112×48",  "usage": "Wordmark only — dark bg" }
    ],
    "banners": [
      { "file": "bzd-banner-linkedin.svg", "size": "1584×396", "usage": "LinkedIn cover photo" },
      { "file": "bzd-banner-github.svg",   "size": "1280×640", "usage": "GitHub org / social cover" }
    ]
  }
}
